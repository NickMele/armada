#!/usr/bin/env python3
#
# This is a shim. The real implementation is `armada land` (Rust,
# `crates/armada/src/land/`) — read `docs/capabilities/merge-line.md` for the
# design and `docs/practices/running-locally.md`, "Landing a branch", for how
# to run it. This file stays, under this name, because `work-issue` step 6
# and agents' own muscle memory type `scripts/land`; it does nothing but
# exec into the real binary, unmodified argv and all.
#
# `armada` is resolved on `$PATH`, the same prerequisite this line already
# had for its `covers` verb (`docs/practices/running-locally.md`).
# `scripts/test_land.py` is unmodified and is the proof this shim carries
# every argument and every exit code through faithfully.
#
# The real default now lives in `crates/armada/src/land/env.rs`, kept
# honest by that crate's own `the_setup_default_says_what_the_manifest_requires`
# test. This exact substring — ARMADA_LAND_SETUP", "bootstrap browsers" —
# is what `scripts/test_land.py`'s own copy of that test still scrapes out
# of this file, unmodified; it must be kept in step with `env.rs`'s.

import os
import sys

if __name__ == "__main__":
    os.execvp("armada", ["armada", "land", *sys.argv[1:]])
