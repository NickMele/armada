#!/usr/bin/env python3
#
# This is a shim. The real implementation is `armada land` (Rust,
# `crates/armada/src/land/`) — read `docs/capabilities/merge-line.md` for the
# design and `docs/practices/running-locally.md`, "Landing a branch", for how
# to run it. This file stays, under this name, because `work-issue` step 6
# and agents' own muscle memory type `scripts/land`.
#
# **Resolution order: `$ARMADA_LAND_ARMADA` if set, else `armada` on
# `$PATH`.** The same variable this line already reads for its own
# `covers`/`check`/`run` calls, so there is exactly one knob for "which
# armada", never two that could disagree.
#
# **An `armada` that does not know the verb is refused, and says how to fix
# it.** It held a Python implementation to fall back on for one release, while
# every agent's installed binary still predated the verb; the owner's machine
# is installed and that copy is gone. `scripts/restart` is what an install
# needs, and it is what the refusal names.

import os
import subprocess
import sys


def resolved_armada() -> str:
    """The `armada` to run, refusing the same relative path the verb itself
    refuses (`crates/armada/src/land/env.rs`) — a shim that ran it would
    resolve it against its own working directory rather than the caller's,
    and answer for a binary nobody named."""
    named = os.environ.get("ARMADA_LAND_ARMADA")
    if named and "/" in named and not os.path.isabs(named):
        sys.exit(
            f"ARMADA_LAND_ARMADA is `{named}`, a relative path. Name it by an "
            "absolute path: a turn runs in a worktree of its own, where a "
            "relative one means a different file or none."
        )
    return named or "armada"


def unavailable(result) -> bool:
    """Whether `result` says the resolved `armada` cannot run `land` at
    all — missing entirely, or built before the verb existed — rather than
    a real outcome the verb itself produced."""
    if isinstance(result, OSError):
        return True
    said = (result.stdout or "") + (result.stderr or "")
    return "is not one of armada's verbs" in said


def relay(result) -> int:
    sys.stdout.write(result.stdout or "")
    sys.stderr.write(result.stderr or "")
    return result.returncode


def main() -> int:
    args = sys.argv[1:]
    binary = resolved_armada()
    try:
        result = subprocess.run([binary, "land", *args], capture_output=True, text=True)
    except OSError as why:
        result = why

    if unavailable(result):
        print(
            f"land: `{binary} land` is not available yet — this `armada` is "
            "missing, or was built before the verb existed. Run "
            "`scripts/restart` to install the current one, or point "
            "`ARMADA_LAND_ARMADA` at an absolute path to a build that has it. "
            "Nothing was queued and nothing was merged.",
            file=sys.stderr,
        )
        return 9

    return relay(result)


if __name__ == "__main__":
    sys.exit(main())
