#!/usr/bin/env python3
#
# Merge one branch to `main` in turn, rerunning the Checks its combination with
# a moved `main` hits. For agents working outside Fleet, once the owner has said
# merge. `docs/capabilities/merge-line.md` is the design and maps each part onto
# Fleet; `docs/practices/running-locally.md`, "Landing a branch", is how to run it.
#
#   scripts/land preflight          ready this branch, and stamp its tree
#   scripts/land                    join the line, and return at once
#   scripts/land --status [branch]  where it is, answered from disk
#
# **Merges wait in line; work does not.** One runner at a time holds the turn,
# and holds it with `fcntl.flock`: the kernel drops the lock when the holder
# dies, so there is no timeout to evict a slow holder that is still running.
#
# **The runner is detached with `start_new_session=True`, not launchd.** It has
# to outlive the Bash call that queued it, which kills its command at 600 s, and
# a new session reparented to launchd does that. `scripts/restart` needs a
# launchd label because Fleet must be *restarted*; a runner only has to finish,
# and a second one started by `--status` picks up whatever a dead one left.
#
# **When `main` has moved**, `main` is merged into the branch in a throwaway
# detached worktree, and every Check whose `when:` matches what landed or what
# the branch changed runs there — `armada covers` chooses, so this never reads
# YAML — plus `verify-foundations`, where only a failing line `main`'s own run
# lacks is red. When `main` has not moved, nothing reruns: the branch's own
# Checks are the agent's, and this gates the combination.
#
# **The merge is `gh pr merge --merge --match-head-commit`**, never a rebase, a
# squash or a push to `main`. `main` is read again right before it, and the
# merge commit's first parent is compared with the base that was gated after.
#
# Exit codes, the same from `--status` as from the outcome they report:
#
#   0  landed, queued, or ready          4  red: a rerun Check or a new line
#   1  refused before joining the line   5  conflict: merge main in and resubmit
#   2  usage                             6  landed, but ungated: main moved
#   3  still in line                     7  stopped: the outcome says why
#                                        8  nothing known about this branch
#
# Every swappable binary is named by an absolute path: the runner works from the
# common git directory, so a relative one resolves somewhere else.
#
# Swappable for tests, so nothing there reaches GitHub: ARMADA_LAND_GH,
# ARMADA_LAND_REMOTE, ARMADA_LAND_BASE, ARMADA_LAND_ARMADA,
# ARMADA_LAND_FOUNDATIONS, ARMADA_LAND_SETUP, ARMADA_LAND_SEED.
# `scripts/test_land.py` is the proof.

import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import traceback
import uuid

GH = os.environ.get("ARMADA_LAND_GH", "gh")
REMOTE = os.environ.get("ARMADA_LAND_REMOTE", "origin")
BASE = os.environ.get("ARMADA_LAND_BASE", "main")
ARMADA = os.environ.get("ARMADA_LAND_ARMADA", "armada")
FOUNDATIONS = shlex.split(
    os.environ.get("ARMADA_LAND_FOUNDATIONS", "cargo xtask verify-foundations")
)
# Commands from `armada.yml`'s `setup.requires` and `setup.seed.paths`, run and
# cloned into a gate worktree before a Check. A second copy of the Manifest's
# answer, named in the capability doc as what does not port.
SETUP = os.environ.get("ARMADA_LAND_SETUP", "bootstrap browsers").split()
SEED = os.environ.get("ARMADA_LAND_SEED", "target").split()
# How long GitHub may take to see a pushed head before the merge pins it.
HEAD_WAIT = float(os.environ.get("ARMADA_LAND_HEAD_WAIT", "120"))
# Rounds of "main moved again while this was gated" before giving the turn up.
ROUNDS = 5

EXIT = {
    "landed": 0,
    "refused": 1,
    "waiting": 3,
    "gating": 3,
    "merging": 3,
    "red": 4,
    "conflict": 5,
    "ungated": 6,
    "stopped": 7,
    "unknown": 8,
}
GENERATED = re.compile(r"GENERATED by `([^`]+)`")
# A finding names its subject as `path:line`, so inserting a line above an old
# failure renumbers it. Compared without the number, it is the same failure.
NUMBERED = re.compile(r":\d+")


class Refused(Exception):
    """Said to the caller before anything joins the line."""


class Stop(Exception):
    """Ends one branch's turn with an outcome."""

    def __init__(self, state, detail, **extra):
        super().__init__(detail)
        self.state = state
        self.detail = detail
        self.extra = extra


# ---------------------------------------------------------------- processes


def run(argv, cwd, stdin=None, check=True, log=None):
    try:
        done = subprocess.run(
            argv,
            cwd=cwd,
            input=stdin,
            capture_output=True,
            text=True,
        )
    except OSError as why:
        # A relative ARMADA_LAND_ARMADA is the way in: the gate runs elsewhere.
        raise Stop("stopped", f"`{argv[0]}` could not be run from {cwd}: {why}") from why
    if log:
        with open(log, "a") as out:
            out.write(f"$ {shlex.join(argv)}\n{done.stdout}{done.stderr}")
            out.write(f"[exit {done.returncode}]\n")
    if check and done.returncode != 0:
        said = (done.stderr or done.stdout).strip().splitlines()
        raise Stop("stopped", f"`{shlex.join(argv)}` failed: {said[-1] if said else done.returncode}")
    return done


def git(cwd, *args, check=True):
    return run(["git", *args], cwd, check=check).stdout.strip()


def remote_head(cwd, branch):
    said = git(cwd, "ls-remote", REMOTE, f"refs/heads/{branch}")
    return said.split()[0] if said else None


def gh_view(cwd, pr, fields):
    done = run([GH, "pr", "view", str(pr), "--json", fields], cwd, check=False)
    if done.returncode != 0:
        return None
    return json.loads(done.stdout)


# ---------------------------------------------------------------- state on disk


def common_dir(cwd):
    return git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")


def state_dir(cwd):
    at = os.path.join(common_dir(cwd), "armada-land")
    for sub in ("queue", "outcomes", "stamps", "logs", "gates", "foundations"):
        os.makedirs(os.path.join(at, sub), exist_ok=True)
    return at


def key(branch):
    # Branch names hold `/`, so a file is named by a hash and carries the name.
    return hashlib.sha256(branch.encode()).hexdigest()[:16]


def read_json(path):
    try:
        with open(path) as held:
            return json.load(held)
    except (OSError, ValueError):
        return None


def write_json(path, value):
    fresh = f"{path}.{os.getpid()}.tmp"
    with open(fresh, "w") as out:
        json.dump(value, out, indent=2)
    os.replace(fresh, path)


def queued(state):
    entries = []
    folder = os.path.join(state, "queue")
    for name in os.listdir(folder):
        if name.endswith(".json"):
            entry = read_json(os.path.join(folder, name))
            # Skipped like unreadable JSON: one bad entry may not stop the line.
            if entry and {"branch", "place", "nonce"} <= entry.keys():
                entries.append(entry)
    return sorted(entries, key=lambda entry: entry["place"])


def outcome_path(state, branch):
    return os.path.join(state, "outcomes", f"{key(branch)}.json")


def say(state, branch, status, detail, **extra):
    held = read_json(outcome_path(state, branch)) or {}
    held.update(extra)
    held.update(
        branch=branch,
        state=status,
        detail=detail,
        updated=time.strftime("%H:%M:%S"),
        runner=os.getpid(),
    )
    write_json(outcome_path(state, branch), held)


# ---------------------------------------------------------------- the caller's tree


def current_branch(cwd):
    done = run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], cwd, check=False)
    return done.stdout.strip() or None


def ready_tree(cwd):
    """The branch, head and tree, refused unless every byte is committed and pushed."""
    branch = current_branch(cwd)
    if not branch or branch == BASE:
        raise Refused(f"check out the branch to land; this is {branch or 'a detached HEAD'}")
    dirty = git(cwd, "status", "--porcelain", "--untracked-files=all")
    if dirty:
        raise Refused(
            "the tree has uncommitted or untracked files, and a stamp would not "
            "describe what lands — commit or remove them:\n" + dirty
        )
    head = git(cwd, "rev-parse", "HEAD")
    pushed = remote_head(cwd, branch)
    if pushed != head:
        ahead = pushed and run(["git", "merge-base", "--is-ancestor", head, pushed], cwd, check=False).returncode == 0
        if ahead:
            # A stopped turn pushed its gate's merge commit. Force-pushing over
            # it would throw the gated merge away.
            raise Refused(
                f"{REMOTE}/{branch} is ahead of this worktree — a turn merged {BASE} in and pushed it. "
                f"Take it: `git fetch {REMOTE} && git reset --hard {REMOTE}/{branch}`. Never force-push over it."
            )
        raise Refused(f"{REMOTE}/{branch} is not this commit — `git push -u {REMOTE} {branch}` first")
    return branch, head, git(cwd, "rev-parse", "HEAD^{tree}")


def covers(cwd, paths):
    done = run([ARMADA, "covers"], cwd, stdin="\n".join(paths) + "\n", check=False)
    if done.returncode != 0:
        raise Stop("stopped", f"`{ARMADA} covers` refused: {done.stderr.strip()}")
    return [line.strip() for line in done.stdout.splitlines() if line.strip()]


def relative_binaries():
    """The runner works from the common git directory, so a relative path to a
    binary resolves somewhere else. Refused where the person can still fix it."""
    for name, value in (("ARMADA_LAND_ARMADA", ARMADA), ("ARMADA_LAND_GH", GH),
                        ("ARMADA_LAND_FOUNDATIONS", FOUNDATIONS[0] if FOUNDATIONS else "")):
        if os.sep in value and not os.path.isabs(value):
            raise Refused(f"{name}={value} is relative, and the gate runs in another directory — give an absolute path")


def preflight(cwd):
    state = state_dir(cwd)
    relative_binaries()
    branch, head, tree = ready_tree(cwd)
    pr = gh_view(cwd, branch, "number,state,headRefOid,baseRefName")
    if not pr:
        raise Refused(f"no pull request for {branch} — `{GH} pr create` first")
    if pr["state"] != "OPEN" or pr["baseRefName"] != BASE:
        raise Refused(f"pull request #{pr['number']} is {pr['state']} against {pr['baseRefName']}, not open against {BASE}")
    if pr["headRefOid"] != head:
        raise Refused(f"GitHub still shows #{pr['number']} at {pr['headRefOid'][:10]}; run preflight again in a moment")
    git(cwd, "fetch", "--quiet", REMOTE, BASE)
    base = git(cwd, "merge-base", "HEAD", f"{REMOTE}/{BASE}")
    changed = git(cwd, "diff", "--name-only", base, head).splitlines()
    try:
        hits = covers(cwd, changed)
    except Stop as stop:
        raise Refused(stop.detail)
    write_json(
        os.path.join(state, "stamps", f"{key(branch)}.json"),
        {"branch": branch, "head": head, "tree": tree, "base": base, "pr": pr["number"], "checks": hits},
    )
    print(f"ready: {branch}, pull request #{pr['number']}, tree {tree[:10]}")
    print(f"Checks this change hits: {', '.join(hits) or 'none'}. Each should have passed on this tree.")
    print("When the owner says merge: scripts/land")
    return 0


# ---------------------------------------------------------------- joining the line


def runner_alive(state):
    with open(os.path.join(state, "runner.lock"), "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(lock, fcntl.LOCK_UN)
        return False


def ensure_runner(state):
    """Start a runner unless one holds the turn. Two racing here is harmless:
    the loser finds the lock taken and exits."""
    if runner_alive(state):
        return
    log = open(os.path.join(state, "runner.log"), "a")
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--runner", os.path.dirname(state)],
        cwd=os.path.dirname(state),
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
    )


def land(cwd):
    state = state_dir(cwd)
    relative_binaries()
    branch, head, tree = ready_tree(cwd)
    stamp = read_json(os.path.join(state, "stamps", f"{key(branch)}.json"))
    if not stamp or stamp["tree"] != tree or stamp["head"] != head:
        raise Refused("this tree has no preflight stamp — `scripts/land preflight` first")
    entry_path = os.path.join(state, "queue", f"{key(branch)}.json")
    held = read_json(entry_path)
    before = read_json(outcome_path(state, branch)) or {}
    if held:
        place = held["place"]
    elif before.get("state") in ("conflict", "red") and before.get("place"):
        # A turn that ended in the branch's own work keeps its place when the
        # branch comes back: the wait was already served.
        place = before["place"]
    else:
        place = time.time_ns()
    top = git(cwd, "rev-parse", "--show-toplevel")
    write_json(
        entry_path,
        {"branch": branch, "pr": stamp["pr"], "head": head, "tree": tree,
         "place": place, "worktree": top, "nonce": uuid.uuid4().hex},
    )
    write_json(
        outcome_path(state, branch),
        {"branch": branch, "state": "waiting", "detail": "in line", "place": place,
         "pr": stamp["pr"], "updated": time.strftime("%H:%M:%S")},
    )
    ensure_runner(state)
    ahead = [entry["branch"] for entry in queued(state) if entry["place"] < place]
    print(f"queued: {branch}, #{stamp['pr']}, {len(ahead)} ahead")
    print(f"poll: scripts/land --status {branch}")
    return 0


def status(cwd, branch):
    state = state_dir(cwd)
    line = queued(state)
    if line:
        ensure_runner(state)  # takes up a turn a killed runner left
    print(f"merge line: {len(line)} in line" if line else "merge line: empty")
    for n, entry in enumerate(line, 1):
        held = read_json(outcome_path(state, entry["branch"])) or {}
        print(f"  {n}. {entry['branch']}  #{entry['pr']}  {held.get('state', 'waiting')}: {held.get('detail', '')}")
    branch = branch or current_branch(cwd)
    if not branch:
        return 0
    held = read_json(outcome_path(state, branch))
    if not held:
        print(f"{branch}: nothing known")
        return EXIT["unknown"]
    print(f"{branch}: {held['state']} — {held['detail']}")
    for name in ("failed", "new_lines", "conflicts", "logs", "cleanup"):
        for item in held.get(name) or []:
            print(f"  {item}")
    return EXIT[held["state"]]


# ---------------------------------------------------------------- the runner


def runner(common):
    state = os.path.join(common, "armada-land")
    lock = open(os.path.join(state, "runner.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    while True:
        line = queued(state)
        if not line:
            # Release, then look once more: an entry written after the last
            # look either shows up now or found the lock free and started a runner.
            fcntl.flock(lock, fcntl.LOCK_UN)
            if not queued(state):
                return 0
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            continue
        entry = line[0]
        try:
            take_turn(state, entry)
        except Stop as stop:
            say(state, entry["branch"], stop.state, stop.detail, **stop.extra)
        except Exception:
            say(state, entry["branch"], "stopped", "the runner failed: " + traceback.format_exc().strip().splitlines()[-1])
        finally:
            entry_path = os.path.join(state, "queue", f"{key(entry['branch'])}.json")
            if (read_json(entry_path) or {}).get("nonce") == entry["nonce"]:
                os.remove(entry_path)


def take_turn(state, entry):
    repo = os.path.dirname(state)
    branch, pr = entry["branch"], entry["pr"]
    logs = os.path.join(state, "logs", key(branch))
    shutil.rmtree(logs, ignore_errors=True)
    os.makedirs(logs)
    held = read_json(outcome_path(state, branch)) or {}
    say(state, branch, "gating", "reading the pull request", logs=[], failed=[], new_lines=[], conflicts=[])

    for _ in range(ROUNDS):
        view = gh_view(repo, pr, "state,baseRefName,headRefOid,mergeCommit")
        if not view:
            raise Stop("stopped", f"`{GH} pr view {pr}` answered nothing")
        if view["state"] == "MERGED" and held.get("gated_base"):
            return prove(state, entry, held["gated_base"])  # a killed runner had merged it
        if view["state"] != "OPEN":
            raise Stop("stopped", f"pull request #{pr} is {view['state']}")
        if view["baseRefName"] != BASE:
            raise Stop("stopped", f"#{pr} is against {view['baseRefName']} now, not {BASE} — nothing here gates that base")

        head = remote_head(repo, branch)
        if head not in (entry["head"], held.get("pushed")):
            raise Stop("stopped", f"{branch} moved on {REMOTE} since it was queued — preflight and land again")
        git(repo, "fetch", "--quiet", REMOTE, BASE, f"refs/heads/{branch}")
        base = remote_head(repo, BASE)

        if run(["git", "merge-base", "--is-ancestor", base, head], repo, check=False).returncode == 0:
            candidate = head
            say(state, branch, "gating", f"{BASE} has not moved since this branch's Checks; nothing reruns")
        else:
            candidate = gate(state, entry, head, base, logs)
            held = read_json(outcome_path(state, branch)) or {}

        say(state, branch, "merging", f"merging #{pr} at {candidate[:10]} onto {base[:10]}",
            gated_base=base, candidate=candidate)
        if remote_head(repo, BASE) != base:
            continue  # main moved while gating: gate again against the new one
        merged = run([GH, "pr", "merge", str(pr), "--merge", "--match-head-commit", candidate],
                     repo, check=False, log=os.path.join(logs, "merge.log"))
        if merged.returncode != 0:
            after = gh_view(repo, pr, "state") or {}
            if after.get("state") != "MERGED":
                raise Stop("stopped", f"GitHub refused the merge: {(merged.stderr or merged.stdout).strip()}")
        return prove(state, entry, base)
    raise Stop("stopped", f"{BASE} moved during each of {ROUNDS} gates; land again when it is quieter")


def gate(state, entry, head, base, logs):
    """Merge `base` into `head` in a throwaway worktree, rerun what the
    combination hits, and push the merge onto the branch. Returns its commit."""
    repo = os.path.dirname(state)
    branch = entry["branch"]
    where = os.path.join(state, "gates", key(branch))
    drop_worktree(repo, where)
    git(repo, "worktree", "add", "--quiet", "--detach", where, head)
    try:
        say(state, branch, "gating", f"merging {BASE} ({base[:10]}) in")
        merge_in(state, entry, where, base, logs)
        nothing_left(where, "the merge")
        candidate = git(where, "rev-parse", "HEAD")

        # Whether or not a Check reruns: verify-foundations always does, and a
        # tree without `target/` reads its own missing build as a new failure.
        prepare(repo, where, logs)
        nothing_left(where, "preparing the gate")
        since = git(repo, "merge-base", head, base)
        landed = git(repo, "diff", "--name-only", since, base).splitlines()
        changed = git(repo, "diff", "--name-only", since, head).splitlines()
        # **Either side, not both.** A Check only one side hits is exactly the
        # seam that breaks in combination — a Rust change landing on the base
        # against a branch's TypeScript, where the generated types meet. One
        # call over both sets is that union, in the order the Manifest writes.
        rerun = covers(where, landed + changed)

        failed, log_paths = [], []
        for name in rerun:
            say(state, branch, "gating", f"running {name} ({', '.join(rerun)})")
            log = os.path.join(logs, f"{name}.log")
            log_paths.append(log)
            if run([ARMADA, "check", name], where, check=False, log=log).returncode != 0:
                failed.append(name)

        # A Check that wrote in the tree measured something the candidate commit
        # does not carry.
        nothing_left(where, "the Checks")
        say(state, branch, "gating", "reading verify-foundations against " + BASE, logs=log_paths)
        new_lines = foundations_delta(state, where, base, logs)
        nothing_left(where, "verify-foundations")
        log_paths.append(os.path.join(logs, "foundations.log"))

        if failed or new_lines:
            raise Stop(
                "red",
                f"red with {BASE} merged in: " + ", ".join(
                    ([f"{', '.join(failed)} failed"] if failed else [])
                    + ([f"{len(new_lines)} verify-foundations line(s) {BASE} does not have"] if new_lines else [])
                ) + ". Nothing was pushed or merged.",
                failed=failed, new_lines=new_lines, logs=log_paths,
            )

        pushed = run(["git", "push", "--quiet", REMOTE, f"{candidate}:refs/heads/{branch}"], where, check=False)
        if pushed.returncode != 0:
            raise Stop("stopped", f"{branch} moved on {REMOTE} while it was gated — preflight and land again")
        say(state, branch, "gating", f"{', '.join(rerun) or 'no Check'} passed with {BASE} merged in; waiting for GitHub to see {candidate[:10]}",
            pushed=candidate, logs=log_paths)
        wait_for_head(repo, entry["pr"], candidate)
        return candidate
    finally:
        drop_worktree(repo, where)


def merge_in(state, entry, where, base, logs):
    done = run(["git", "-c", "core.hooksPath=/dev/null", "merge", "--no-ff", "--no-edit",
                "-m", f"Merge {BASE} into {entry['branch']}", base],
               where, check=False, log=os.path.join(logs, "merge-in.log"))
    if done.returncode == 0:
        return
    unmerged = git(where, "diff", "--name-only", "--diff-filter=U").splitlines()
    regenerate = {}
    for path in unmerged:
        theirs = run(["git", "show", f":3:{path}"], where, check=False).stdout
        found = GENERATED.search("\n".join(theirs.splitlines()[:5]))
        if found:
            regenerate[path] = found.group(1)
    others = [path for path in unmerged if path not in regenerate]
    if not unmerged or others:
        run(["git", "merge", "--abort"], where, check=False)
        held = read_json(outcome_path(state, entry["branch"])) or {}
        raise Stop(
            "conflict",
            f"{BASE} does not merge into {entry['branch']} cleanly. Merge {REMOTE}/{BASE} in, "
            "commit, push, preflight and land again — it keeps its place in line.",
            conflicts=others or ["the merge failed without naming a file; see merge-in.log"],
            place=held.get("place", entry["place"]),
        )
    # Generated files are rebuilt from the merged sources, never hand-resolved.
    git(where, "checkout", "--theirs", "--", *regenerate)
    for command in dict.fromkeys(regenerate.values()):
        if run(shlex.split(command), where, check=False, log=os.path.join(logs, "regenerate.log")).returncode != 0:
            run(["git", "merge", "--abort"], where, check=False)
            raise Stop("stopped", f"`{command}` failed while regenerating a conflicted file; see regenerate.log")
    # `-A`, not the conflicted paths: one generator writes several files, and
    # a side effect left unstaged is checked in the worktree and not in the commit.
    git(where, "add", "-A")
    git(where, "-c", "core.hooksPath=/dev/null", "commit", "--quiet", "--no-edit")


def nothing_left(where, after):
    """The gate worktree holds exactly what the candidate commit holds."""
    left = git(where, "status", "--porcelain")
    if left:
        raise Stop("stopped", f"{after} left files the commit does not carry, so the Checks would "
                              f"measure a tree nothing can merge:\n{left}")


def prepare(repo, where, logs, setup=True):
    """Clone the seed paths copy-on-write and run the setup Commands, as Fleet
    does for a Job's worktree. A volume that cannot clone starts cold."""
    main_tree = git(repo, "worktree", "list", "--porcelain").splitlines()[0].split(" ", 1)[1]
    for path in SEED:
        source, target = os.path.join(main_tree, path), os.path.join(where, path)
        if os.path.exists(source) and not os.path.exists(target):
            run(["cp", "-cR", source, target], where, check=False, log=os.path.join(logs, "setup.log"))
    for name in SETUP if setup else []:
        if run([ARMADA, "run", name], where, check=False, log=os.path.join(logs, "setup.log")).returncode != 0:
            raise Stop("stopped", f"`{ARMADA} run {name}` failed preparing the gate; see setup.log")


def failing_lines(text):
    """The rule and finding lines a run printed, which is what a delta reads."""
    return [line.strip() for line in text.splitlines()
            if line.strip().startswith(("FAIL", "missing:"))]


def a_report(text, code):
    """Whether a run said anything about the rules. **A non-zero exit printing no
    failing line is a crash**, not a red gate: a branch that breaks the `xtask`
    build exits 101 with one `error[E0433]` and would otherwise be gated on nothing."""
    return code == 0 or bool(failing_lines(text))


def foundations_delta(state, where, base, logs):
    """Failing lines the merged tree prints that `base`'s own run does not. Red
    on main is legitimate, so only a new `FAIL` or `missing:` line is red; a new
    warning is not a failure on main either, and the summary line's counts move
    with every change."""
    repo = os.path.dirname(state)
    known = {NUMBERED.sub("", line) for line in base_foundations(state, base, logs)}
    done = run(FOUNDATIONS, where, check=False, log=os.path.join(logs, "foundations.log"))
    said = done.stdout + done.stderr
    if not a_report(said, done.returncode):
        raise Stop("red", f"`{shlex.join(FOUNDATIONS)}` exited {done.returncode} with {BASE} merged in "
                          "and named no failing rule, so nothing was gated; see foundations.log",
                   new_lines=failing_lines(said) or said.strip().splitlines()[-3:], logs=[os.path.join(logs, "foundations.log")])
    return [line for line in failing_lines(said) if NUMBERED.sub("", line) not in known]


def base_foundations(state, base, logs):
    """What `base`'s own run printed, kept per commit. **Cached only once it has
    been read as a report**: a half-written or crashed run cached under a base
    sha would read main's own failures as new for every branch after it."""
    repo = os.path.dirname(state)
    cached = os.path.join(state, "foundations", f"{base}.txt")
    held = read_text(cached) or ""
    marked, _, body = held.partition("\n")
    if marked == "report":
        return failing_lines(body)
    at = os.path.join(state, "gates", f"base-{base[:12]}")
    drop_worktree(repo, at)
    git(repo, "worktree", "add", "--quiet", "--detach", at, base)
    try:
        prepare(repo, at, logs)
        done = run(FOUNDATIONS, at, check=False, log=os.path.join(logs, "foundations-base.log"))
        said = done.stdout + done.stderr
    finally:
        drop_worktree(repo, at)
    if not a_report(said, done.returncode):
        raise Stop("stopped", f"`{shlex.join(FOUNDATIONS)}` exited {done.returncode} on {BASE} itself and "
                              "named no failing rule, so there is nothing to compare against; see foundations-base.log")
    fresh = f"{cached}.{os.getpid()}.tmp"
    with open(fresh, "w") as out:
        out.write("report\n" + said)
    os.replace(fresh, cached)
    return failing_lines(said)


def read_text(path):
    try:
        with open(path) as held:
            return held.read()
    except OSError:
        return None


def wait_for_head(repo, pr, candidate):
    deadline = time.monotonic() + HEAD_WAIT
    while time.monotonic() < deadline:
        view = gh_view(repo, pr, "headRefOid") or {}
        if view.get("headRefOid") == candidate:
            return
        time.sleep(2)
    raise Stop("stopped", f"GitHub did not show #{pr} at {candidate[:10]} within {int(HEAD_WAIT)} s; land again")


def prove(state, entry, base):
    repo = os.path.dirname(state)
    branch, pr = entry["branch"], entry["pr"]
    view = gh_view(repo, pr, "state,mergeCommit") or {}
    commit = (view.get("mergeCommit") or {}).get("oid")
    if view.get("state") != "MERGED" or not commit:
        raise Stop("stopped", f"#{pr} did not read as merged afterwards: {view}")
    git(repo, "fetch", "--quiet", REMOTE, BASE)
    first_parent = git(repo, "rev-parse", f"{commit}^1")
    cleanup = []
    if entry.get("worktree"):
        cleanup = [
            "once `git status --porcelain` there prints nothing (agent-worktrees):",
            f"git worktree remove --force {shlex.quote(entry['worktree'])}",
            f"git branch -D {shlex.quote(branch)}",
        ]
    stamp = os.path.join(state, "stamps", f"{key(branch)}.json")
    if os.path.exists(stamp):
        os.remove(stamp)
    if first_parent != base:
        # The branch stays, because what landed was never checked and somebody
        # has to be able to read it.
        raise Stop(
            "ungated",
            f"#{pr} merged as {commit[:10]}, but its first parent is {first_parent[:10]}, not the "
            f"{base[:10]} it was gated against: an ungated combination landed on {BASE}. Say so to the owner.",
            merge_commit=commit, cleanup=cleanup,
        )
    run(["git", "push", "--quiet", REMOTE, "--delete", branch], repo, check=False)
    raise Stop("landed", f"#{pr} merged as {commit[:10]} onto {base[:10]}, the base it was gated against",
               merge_commit=commit, cleanup=cleanup)


def drop_worktree(repo, where):
    """Only ever this runner's own throwaway gate trees, under the state directory."""
    if os.path.exists(where):
        run(["git", "worktree", "remove", "--force", where], repo, check=False)
        shutil.rmtree(where, ignore_errors=True)
    run(["git", "worktree", "prune"], repo, check=False)


# ---------------------------------------------------------------- entry


def main():
    parser = argparse.ArgumentParser(prog="scripts/land", description="Merge this branch to main in turn.")
    parser.add_argument("act", nargs="?", choices=["preflight"])
    parser.add_argument("--status", nargs="?", const="", metavar="branch")
    parser.add_argument("--runner", metavar="common-git-dir", help=argparse.SUPPRESS)
    asked = parser.parse_args()
    if asked.runner:
        return runner(asked.runner)
    cwd = os.getcwd()
    try:
        if asked.status is not None:
            return status(cwd, asked.status or None)
        if asked.act == "preflight":
            return preflight(cwd)
        return land(cwd)
    except (Refused, Stop) as why:
        print(f"land: {why}", file=sys.stderr)
        return EXIT["refused"]


if __name__ == "__main__":
    sys.exit(main())
