{
  // The renderer. DOM, JSX, and the shared types the preload's shape is written in.
  //
  // `noUncheckedIndexedAccess` was off here while `@armada/components` did not
  // compile under it — Tabs and TabsWithCounts index a list by a computed
  // position. The primitives now say why that position is in range, so the
  // renderer is checked the same way main and preload already were. Bridge's
  // own code needed no change for it: the generated vocabulary already spells
  // `| undefined` into its own type.
  "compilerOptions": {
    "composite": true,
    // Into out/, which is not committed. A build artefact beside the config is
    // one more thing to ignore by hand.
    "tsBuildInfoFile": "./out/tsconfig.web.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.tsx", "src/shared/**/*.ts"]
}
