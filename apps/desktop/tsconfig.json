{
  // Two projects, because the processes are not interchangeable: the main and
  // preload bundles have Node and no DOM, the renderer has the DOM and no Node.
  // One config covering both would let a renderer component reach for `fs` and
  // still typecheck, which is the boundary `contextIsolation` exists to hold.
  //
  // `tsc -b` from here checks both. Plain `tsc --noEmit` checks neither: this
  // project owns no files on purpose.
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }]
}
