{
  "version": 1,
  "components": {
    "cli": {
      "root": "packages/cli",
      "match": [
        "packages/cli/**"
      ],
      "owns_files": [
        "packages/cli/node_modules"
      ],
      "checks": {
        "lint": {
          "id": "cli:lint",
          "cmd": "pnpm exec eslint ${files}",
          "fix": "pnpm exec eslint --fix ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 1,
          "scope": "file"
        },
        "types": {
          "id": "cli:types",
          "cmd": "pnpm turbo run typecheck --filter @acme/cli",
          "shell": false,
          "timeout": 300,
          "cost": 1,
          "scope": "component",
          "needs": [
            {
              "check": "core:build"
            }
          ]
        }
      }
    },
    "core": {
      "root": "packages/core",
      "match": [
        "packages/core/**"
      ],
      "setup": [
        {
          "cmd": "pnpm install --frozen-lockfile",
          "shell": false
        }
      ],
      "owns_files": [
        "node_modules",
        "packages/core/node_modules"
      ],
      "checks": {
        "build": {
          "id": "core:build",
          "cmd": "pnpm turbo run build --filter @acme/core",
          "shell": false,
          "timeout": 600,
          "cost": 2,
          "scope": "component"
        },
        "lint": {
          "id": "core:lint",
          "cmd": "pnpm exec eslint ${files}",
          "fix": "pnpm exec eslint --fix ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "core:test",
          "cmd": "pnpm exec vitest run --dir packages/core ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 2,
          "scope": "file"
        }
      }
    },
    "docs": {
      "root": "packages/docs",
      "match": [
        "packages/docs/**",
        "*.md"
      ],
      "checks": {
        "lint": {
          "id": "docs:lint",
          "cmd": "pnpm exec markdownlint ${files}",
          "fix": "pnpm exec markdownlint --fix ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 1,
          "scope": "file"
        }
      }
    },
    "ui": {
      "root": "packages/ui",
      "match": [
        "packages/ui/**"
      ],
      "owns_files": [
        "packages/ui/node_modules"
      ],
      "checks": {
        "lint": {
          "id": "ui:lint",
          "cmd": "pnpm exec eslint ${files}",
          "fix": "pnpm exec eslint --fix ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "ui:test",
          "cmd": "pnpm exec vitest run --dir packages/ui ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 2,
          "scope": "file",
          "needs": [
            {
              "check": "core:build"
            }
          ]
        },
        "types": {
          "id": "ui:types",
          "cmd": "pnpm turbo run typecheck --filter @acme/ui",
          "shell": false,
          "timeout": 300,
          "cost": 1,
          "scope": "component",
          "needs": [
            {
              "check": "core:build"
            }
          ]
        }
      }
    }
  },
  "workspaces": [
    "apps/site"
  ]
}
