{
  "version": 1,
  "components": {
    "data": {
      "root": "pipelines/data",
      "match": [
        "pipelines/data/**"
      ],
      "setup": [
        {
          "cmd": "uv sync --frozen",
          "shell": false
        }
      ],
      "owns_files": [
        ".venv"
      ],
      "checks": {
        "lint": {
          "id": "data:lint",
          "cmd": "uv run ruff check ${files}",
          "fix": "uv run ruff check --fix ${files}",
          "shell": false,
          "timeout": 120,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "data:test",
          "cmd": "uv run pytest ${files}",
          "shell": false,
          "timeout": 600,
          "cost": 2,
          "scope": "file"
        },
        "types": {
          "id": "data:types",
          "cmd": "uv run mypy pipelines/data",
          "shell": false,
          "timeout": 600,
          "cost": 1,
          "scope": "component"
        }
      }
    },
    "notebooks": {
      "root": "notebooks",
      "match": [
        "notebooks/**"
      ],
      "checks": {
        "lint": {
          "id": "notebooks:lint",
          "cmd": "uv run nbqa ruff ${files}",
          "shell": false,
          "timeout": 300,
          "cost": 1,
          "scope": "file"
        }
      }
    },
    "train": {
      "root": "pipelines/train",
      "match": [
        "pipelines/train/**"
      ],
      "checks": {
        "lint": {
          "id": "train:lint",
          "cmd": "uv run ruff check ${files}",
          "fix": "uv run ruff check --fix ${files}",
          "shell": false,
          "timeout": 120,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "train:test",
          "cmd": "uv run pytest pipelines/train",
          "shell": false,
          "timeout": 1800,
          "cost": 6,
          "scope": "component",
          "exclusive": [
            "gpu"
          ],
          "env": {
            "CUDA_VISIBLE_DEVICES": "0"
          }
        }
      }
    }
  }
}
