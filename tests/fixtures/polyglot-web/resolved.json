{
  "version": 1,
  "components": {
    "api": {
      "root": "backend",
      "match": [
        "backend/**"
      ],
      "setup": [
        {
          "cmd": "uv sync --frozen",
          "shell": false
        }
      ],
      "owns_files": [
        "backend/.venv"
      ],
      "run": {
        "driver": "compose",
        "file": [
          "docker-compose.yml",
          "docker-compose.dev.yml"
        ],
        "ports": {
          "api": 8000
        },
        "ready": {
          "kind": {
            "http": "http://127.0.0.1:${port.api}/healthz"
          },
          "timeout": 60
        },
        "needs": [
          {
            "component": "postgres"
          }
        ],
        "env": {
          "DJANGO_SETTINGS_MODULE": "app.settings.dev"
        }
      },
      "checks": {
        "lint": {
          "id": "api:lint",
          "cmd": "uv run --project backend ruff check ${files}",
          "fix": "uv run --project backend ruff check --fix ${files}",
          "shell": false,
          "timeout": 120,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "api:test",
          "cmd": "pytest ${files}",
          "shell": false,
          "timeout": 600,
          "cost": 4,
          "scope": "file",
          "needs": [
            {
              "component": "postgres"
            }
          ],
          "env": {
            "DJANGO_SETTINGS_MODULE": "app.settings.test"
          },
          "in": "api"
        },
        "types": {
          "id": "api:types",
          "cmd": "uv run --project backend mypy backend",
          "shell": false,
          "timeout": 300,
          "cost": 1,
          "scope": "component"
        }
      }
    },
    "postgres": {
      "run": {
        "driver": "compose",
        "file": [
          "docker-compose.yml"
        ],
        "ports": {
          "pg": 5432
        },
        "ready": {
          "kind": {
            "tcp": "pg"
          },
          "timeout": 90
        }
      }
    },
    "web": {
      "root": "web",
      "match": [
        "web/**"
      ],
      "setup": [
        {
          "cmd": "pnpm install --frozen-lockfile",
          "shell": false
        }
      ],
      "owns_files": [
        "web/node_modules"
      ],
      "run": {
        "driver": "command",
        "cmd": "pnpm exec next dev --port ${port.web} --dir web",
        "shell": false,
        "ports": {
          "web": 3000
        },
        "ready": {
          "kind": {
            "log": "ready started server on"
          },
          "timeout": 60
        },
        "needs": [
          {
            "component": "api"
          }
        ],
        "env": {
          "NODE_ENV": "development"
        }
      },
      "checks": {
        "e2e": {
          "id": "web:e2e",
          "cmd": "pnpm --filter web run e2e",
          "shell": false,
          "timeout": 900,
          "cost": 4,
          "scope": "component",
          "exclusive": [
            "browser"
          ],
          "needs": [
            {
              "component": "api"
            },
            {
              "component": "web"
            }
          ]
        },
        "lint": {
          "id": "web:lint",
          "cmd": "pnpm exec eslint ${files}",
          "fix": "pnpm exec eslint --fix ${files}",
          "shell": false,
          "timeout": 120,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "web:test",
          "cmd": "pnpm exec vitest run --dir web ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 2,
          "scope": "file"
        },
        "types": {
          "id": "web:types",
          "cmd": "pnpm --filter web run typecheck",
          "shell": false,
          "timeout": 300,
          "cost": 1,
          "scope": "component"
        }
      }
    }
  },
  "commands": {
    "design": {
      "cmd": "uv run scripts/design.py",
      "help": "Sync design tokens",
      "shell": false,
      "stdio": "pipe"
    },
    "tickets": {
      "cmd": "uv run scripts/tickets.py",
      "help": "Report stale tickets",
      "shell": false,
      "stdio": "inherit"
    },
    "worktrees": {
      "cmd": "uv run scripts/worktrees.py",
      "help": "Create and tear down git worktrees",
      "shell": false,
      "stdio": "inherit",
      "env": {
        "REGISTRY": "${env.COMPANY_REGISTRY}",
        "WORKSPACE": "${workspace.id}"
      },
      "owns_containers": "label=com.example.worktree=${workspace.id}",
      "owns_networks": "label=com.example.worktree=${workspace.id}",
      "owns_files": [
        ".worktrees/${workspace.id}"
      ],
      "secrets": [
        "GITHUB_TOKEN"
      ]
    }
  },
  "skills": {
    "add-endpoint": {
      "summary": "Add an API endpoint, OpenAPI first, then the generated client",
      "doc": "docs/skills/add-endpoint.md",
      "uses": [
        "tickets"
      ],
      "verify": [
        "api:types",
        "web:lint"
      ],
      "touches": [
        "backend/openapi.yaml",
        "frontend/src/generated/**"
      ]
    },
    "triage-flake": {
      "summary": "Work out whether a failing test is flaky or genuinely broken",
      "doc": "docs/skills/add-endpoint.md"
    }
  },
  "secrets": {
    "GITHUB_TOKEN": "op://Engineering/github/token"
  },
  "secret_providers": {
    "op": "op read ${ref}"
  }
}
