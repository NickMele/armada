{
  "version": 1,
  "components": {
    "app": {
      "match": [
        "app/**",
        "lib/**",
        "config/**",
        "db/**"
      ],
      "setup": [
        {
          "cmd": "bundle install",
          "shell": false
        },
        {
          "cmd": "bin/rails db:create || true",
          "shell": true
        },
        {
          "cmd": "bundle exec rails db:migrate",
          "shell": false
        },
        {
          "cmd": "bundle exec rails db:seed",
          "shell": false
        }
      ],
      "owns_files": [
        "vendor/bundle",
        "tmp/cache"
      ],
      "owns_release": [
        "psql -h db.internal -c 'DROP DATABASE app_${workspace.id}'"
      ],
      "run": {
        "driver": "command",
        "cmd": "bundle exec puma --port ${port.app}",
        "stop": "bundle exec pumactl --pidfile tmp/pids/server.pid stop",
        "shell": false,
        "ports": {
          "app": 3000
        },
        "ready": {
          "kind": {
            "http": "http://127.0.0.1:${port.app}/up"
          },
          "timeout": 120
        },
        "needs": [
          {
            "component": "postgres"
          },
          {
            "component": "redis"
          }
        ],
        "env": {
          "RAILS_ENV": "development",
          "REDIS_URL": "redis://127.0.0.1:${port.redis}/0"
        }
      },
      "checks": {
        "boot": {
          "id": "app:boot",
          "cmd": "bin/rails zeitwerk:check && bin/rails runner 'Rails.application.eager_load!'",
          "shell": true,
          "timeout": 300,
          "cost": 1,
          "scope": "component",
          "needs": [
            {
              "component": "postgres"
            }
          ]
        },
        "lint": {
          "id": "app:lint",
          "cmd": "bundle exec rubocop ${files}",
          "fix": "bundle exec rubocop --autocorrect ${files}",
          "shell": false,
          "timeout": 300,
          "cost": 1,
          "scope": "file"
        },
        "test": {
          "id": "app:test",
          "cmd": "bundle exec rspec ${files}",
          "shell": false,
          "timeout": 900,
          "cost": 2,
          "scope": "file",
          "needs": [
            {
              "component": "postgres"
            },
            {
              "component": "redis"
            }
          ],
          "env": {
            "RAILS_ENV": "test"
          }
        }
      }
    },
    "postgres": {
      "run": {
        "driver": "compose",
        "file": [
          "docker-compose.yml"
        ],
        "ports": {
          "pg": 5432
        },
        "ready": {
          "kind": {
            "tcp": "pg"
          },
          "timeout": 90
        }
      }
    },
    "redis": {
      "run": {
        "driver": "compose",
        "file": [
          "docker-compose.yml"
        ],
        "ports": {
          "redis": 6379
        },
        "ready": {
          "kind": {
            "tcp": "redis"
          },
          "timeout": 60
        }
      }
    },
    "worker": {
      "run": {
        "driver": "command",
        "cmd": "bundle exec sidekiq",
        "shell": false,
        "ready": {
          "kind": "none",
          "timeout": 60
        },
        "needs": [
          {
            "component": "redis"
          },
          {
            "component": "app"
          }
        ],
        "env": {
          "RAILS_ENV": "development",
          "REDIS_URL": "redis://127.0.0.1:${port.redis}/0"
        }
      }
    }
  }
}
