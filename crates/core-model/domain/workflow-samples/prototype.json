{
  "workflow_id": "prototype",
  "version": 1,
  "structure": "linear",
  "default_gate_policy": {
    "retry_limit": 3,
    "iteration_cap": 5,
    "attempt_cap": 15,
    "judge_call_cap": 12,
    "fan_out_cap": 5,
    "fan_out_rate": {
      "count": 3,
      "window_minutes": 10
    },
    "heartbeat_interval_minutes": 5,
    "poke_limit": 2
  },
  "manifest_rule_overrides": {
    "auto_merge": "never"
  },
  "steps": [
    {
      "step_id": "frame",
      "order": 1,
      "required": true,
      "evidence_type": "facts_note",
      "advance_gate": "auto"
    },
    {
      "step_id": "build",
      "order": 2,
      "required": true,
      "evidence_type": "diff",
      "advance_gate": "human_always"
    },
    {
      "step_id": "write_up",
      "order": 3,
      "required": true,
      "evidence_type": "facts_note",
      "advance_gate": "auto"
    }
  ]
}
