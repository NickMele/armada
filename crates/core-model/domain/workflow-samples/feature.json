{
  "workflow_id": "feature",
  "version": 1,
  "structure": "linear",
  "default_gate_policy": {
    "retry_limit": 3,
    "iteration_cap": 5,
    "attempt_cap": 15,
    "judge_call_cap": 12,
    "fan_out_cap": 5,
    "fan_out_rate": {
      "count": 3,
      "window_minutes": 10
    },
    "heartbeat_interval_minutes": 5,
    "poke_limit": 2
  },
  "steps": [
    {
      "step_id": "scope",
      "order": 1,
      "required": true,
      "evidence_type": "facts_note",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": "scope_note"
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "prompt_key": "scope_addresses_request",
          "question": "Does this scope note address what was actually requested, without expanding beyond it?"
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        "reference_docs": [
          "ticket"
        ],
        "exclude_paths": [
          ".env",
          "node_modules/"
        ],
        "max_context_size": 20
      },
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "step_id": "implement",
      "order": 2,
      "required": true,
      "evidence_type": "diff",
      "mechanical_checks": [
        {
          "type": "diff_nonempty"
        },
        {
          "type": "manifest_check",
          "check": "build",
          "expect_exit_code": 0
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "prompt_key": "implementation_matches_scope",
          "question": "Does this diff implement what the scope note described, and nothing outside it?",
          "panel_size": 3
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        "reference_docs": [
          "scope.evidence"
        ],
        "max_context_size": 20,
        "scope_diff_check": true,
        "declare_plan_at": "step_start"
      },
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "step_id": "tests",
      "order": 3,
      "required": true,
      "evidence_type": "diff",
      "mechanical_checks": [
        {
          "type": "diff_nonempty"
        },
        {
          "type": "manifest_check",
          "check": "test",
          "expect_exit_code": 0
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "prompt_key": "tests_exercise_new_behaviour",
          "question": "Do these tests exercise the behaviour the scope note described, rather than restating the implementation?",
          "gaming_check": {
            "enabled": true,
            "baseline_ref": "scope.evidence",
            "flag_if": [
              "assertion_weakened",
              "test_scope_narrowed",
              "tautological_test",
              "check_config_edited"
            ]
          }
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        "reference_docs": [
          "scope.evidence",
          "implement.evidence"
        ],
        "max_context_size": 30,
        "scope_diff_check": true
      },
      "advance_gate": "auto_if_judge_passes",
      "on_gaming_flag": "escalate:evidence_suspect"
    },
    {
      "step_id": "regression_verify",
      "order": 4,
      "required": true,
      "evidence_type": "test_suite_run",
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "test",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "lint",
          "expect_exit_code": 0
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "prompt_key": "no_behaviour_change_beyond_scope",
          "question": "Does this diff change behaviour beyond what the scope note described?"
        }
      ],
      "evidence_scope": {
        "context_source": "hybrid",
        "reference_docs": [
          "scope.evidence",
          "implement.evidence"
        ],
        "max_context_size": 40
      },
      "advance_gate": "auto_if_judge_passes",
      "on_fail": "retry:implement"
    },
    {
      "step_id": "review",
      "order": 5,
      "required": true,
      "evidence_type": "bundle",
      "judge_checks": [
        {
          "enabled": true,
          "model": "sonnet",
          "prompt_key": "final_review_summary",
          "question": "Summarize what this diff does, whether it implements the stated scope, and anything a human reviewer should look at closely.",
          "gates_advancement": false
        }
      ],
      "evidence_scope": {
        "context_source": "hybrid",
        "reference_docs": [
          "ticket",
          "scope.evidence"
        ],
        "max_context_size": 40
      },
      "advance_gate": "human_always",
      "verdict_routing": {
        "request_changes": "implement"
      }
    },
    {
      "step_id": "merge",
      "order": 6,
      "required": true,
      "advance_gate": "manifest_rule:auto_merge"
    },
    {
      "step_id": "close",
      "order": 7,
      "required": true,
      "mechanical_checks": [
        {
          "type": "pr_merged"
        }
      ],
      "advance_gate": "auto"
    }
  ]
}
