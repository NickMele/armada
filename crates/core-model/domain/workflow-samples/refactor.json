{
  "workflow_id": "refactor",
  "version": 1,
  "structure": "loop",
  "default_gate_policy": {
    "retry_limit": 3,
    "iteration_cap": 5,
    "attempt_cap": 15,
    "judge_call_cap": 12,
    "fan_out_cap": 5,
    "fan_out_rate": {
      "count": 3,
      "window_minutes": 10
    },
    "heartbeat_interval_minutes": 5,
    "poke_limit": 2
  },
  "steps": [
    {
      "id": "scope",
      "order": 1,
      "required": true,
      "evidence_type": "facts_note",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": "refactor_scope_note"
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "prompt_key": "refactor_scope_is_structural_only",
          "question": "Does this scope describe a change to structure only, with no intended change to behaviour?"
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        "reference_docs": [
          "ticket"
        ],
        "max_context_size": 20
      },
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "refactor",
      "order": 2,
      "required": true,
      "evidence_type": "diff",
      "mechanical_checks": [
        {
          "type": "diff_nonempty"
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "prompt_key": "refactor_preserves_behaviour",
          "question": "Does this diff restructure code without changing what it does?"
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        "reference_docs": [
          "scope.evidence"
        ],
        "max_context_size": 40,
        "scope_diff_check": true,
        "declare_plan_at": "step_start"
      },
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "regression_verify",
      "order": 3,
      "required": true,
      "hard_prerequisite": true,
      "evidence_type": "test_suite_run",
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "test",
          "expect_exit_code": 0
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "sonnet",
          "panel_size": 2,
          "prompt_key": "refactor_test_changes_justified",
          "question": "Given the stated refactor, are the changes to test files justified by it - or has test scope been narrowed, have assertions been weakened, or have tests been skipped or deleted?",
          "gaming_check": {
            "enabled": true,
            "baseline_ref": "scope.evidence",
            "flag_if": [
              "test_scope_narrowed",
              "assertion_weakened",
              "test_skipped",
              "test_deleted"
            ]
          }
        }
      ],
      "evidence_scope": {
        "context_source": "hybrid",
        "reference_docs": [
          "scope.evidence",
          "refactor.evidence"
        ],
        "max_context_size": 40
      },
      "advance_gate": "auto_if_judge_passes",
      "on_gaming_flag": "escalate:evidence_suspect",
      "on_fail": "retry:refactor"
    },
    {
      "id": "review",
      "order": 4,
      "required": true,
      "evidence_type": "bundle",
      "judge_checks": [
        {
          "enabled": true,
          "model": "sonnet",
          "prompt_key": "final_review_summary",
          "question": "Summarize what this diff restructures, what it left behaviourally identical, and anything a human reviewer should look at closely.",
          "gates_advancement": false
        }
      ],
      "evidence_scope": {
        "context_source": "hybrid",
        "reference_docs": [
          "scope.evidence",
          "regression_verify.evidence"
        ],
        "max_context_size": 40
      },
      "advance_gate": "manifest_rule:review_gate",
      "verdict_routing": {
        "request_changes": "refactor"
      }
    },
    {
      "id": "merge",
      "order": 5,
      "required": true,
      "advance_gate": "manifest_rule:auto_merge"
    },
    {
      "id": "close",
      "order": 6,
      "required": true,
      "mechanical_checks": [
        {
          "type": "pr_merged"
        }
      ],
      "advance_gate": "auto"
    }
  ]
}
