{
  "workflow_id": "code_review",
  "version": 1,
  "structure": "linear",
  "ref_source": "job_specified_branch",
  "requires_worktree": true,
  "requires_checks": false,
  "default_gate_policy": {
    "retry_limit": 3,
    "iteration_cap": 5,
    "attempt_cap": 15,
    "judge_call_cap": 12,
    "fan_out_cap": 5,
    "fan_out_rate": {
      "count": 3,
      "window_minutes": 10
    },
    "heartbeat_interval_minutes": 5,
    "poke_limit": 2
  },
  "steps": [
    {
      "id": "read",
      "order": 1,
      "required": true,
      "evidence_type": "facts_note",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": "read_note"
        }
      ],
      "judge_checks": [],
      "evidence_scope": {
        "context_source": "manifest_default",
        "reference_docs": [
          "pr_description",
          "linked_ticket"
        ],
        "max_context_size": 60
      },
      "advance_gate": "auto"
    },
    {
      "id": "assess",
      "order": 2,
      "required": true,
      "evidence_type": "review_findings",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": "REVIEW.md"
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "sonnet",
          "panel_size": 2,
          "prompt_key": "review_engages_with_the_diff",
          "question": "Do these findings engage with what this diff actually does, citing specific changes - or are they generic observations that would apply to any diff?",
          "gaming_check": {
            "enabled": true,
            "baseline_ref": "read.evidence",
            "flag_if": [
              "no_findings_on_substantial_diff",
              "findings_not_tied_to_changed_lines",
              "findings_generic"
            ]
          }
        }
      ],
      "evidence_scope": {
        "context_source": "hybrid",
        "reference_docs": [
          "read.evidence",
          "pr_description"
        ],
        "max_context_size": 60
      },
      "advance_gate": "auto_if_judge_passes",
      "on_gaming_flag": "escalate:evidence_suspect"
    },
    {
      "id": "deliver",
      "order": 3,
      "required": true,
      "evidence_type": "bundle",
      "judge_checks": [],
      "evidence_scope": {
        "context_source": "hybrid",
        "reference_docs": [
          "assess.evidence"
        ],
        "max_context_size": 20
      },
      "advance_gate": "manifest_rule:review_gate"
    }
  ]
}
