# Design Plan, the loop it was designed as. `bug.json` beside this file carries
# what all eight hold to, and where the schema, the catalogue and the Check
# reasoning live.
#
# `crates/core-model/domain/workflows.toml` calls this Armada's only
# instantiated loop: `draft` and `present`, with `present`'s `request_changes`
# routing back to `draft`. The routing and the cap of five are the designed
# file's; the cap lives on the step here rather than under
# `default_gate_policy`, which the parser still defers.
# `crates/fleet/src/tests/looping.rs` drives this file, off disk, round twice
# and then into a spent cap.
#
# **This workflow carries no Judge, and that is a decision rather than an
# omission.** The designed file carries none either: Design Plan is a
# back-and-forth the engineer ends when the design is in a good place, which
# `workflowdef-fields.toml` says treating as a config error would break. What
# ends it is `present`'s `human_always`, and what carries the reading back to
# `draft` is the loop.
#
# **`draft` is the one step where `artifact_exists` is the whole gate**, since
# with no Judge nothing else reads what it produced. It refuses an empty file
# and it refuses a directory of that name, and it still cannot tell a considered
# design from a sentence.
#
# The deliverable stays under `.armada/`. Where one *should* live is
# `[deliverable-location]` in `docs/OPEN.md`, and is a different question.
{
  "version": 1,
  "workflow_id": "design_plan",
  "name": "design_plan",
  "structure": "loop",
  "steps": [
    {
      "id": "draft",
      "label": "Draft",
      "evidence_type": "document",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/draft.md"
        }
      ],
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "present",
      "label": "Present",
      "evidence_type": "document",
      "delivers": false,
      "advance_gate": "human_always",
      "verdict_routing": {
        "request_changes": "draft"
      },
      "iteration_cap": 5
    }
  ]
}
