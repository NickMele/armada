# Feature, reduced to what M1's parser accepts. `bug.json` beside this file
# carries what all eight hold to, and where the schema, the catalogue and the
# Check reasoning live.
#
# The designed `feature.json` runs seven steps in a loop. This form keeps
# `scope`, `implement` and `tests`, and folds `review`, `merge` and `close` into
# one `handoff` -- Bug's fold. `regression_verify`'s question does not vanish
# with its step: it is carried as `implement`'s second criterion, on the diff it
# was asking about.
#
# **`handoff` is gated `human_always`, and here that is the folded `review`
# step's own gate.** Of the three the fold swallows, `review`'s is the
# strictest; the other two reach for a Manifest rule the parser still defers.
# Feature is where the designed file spells `human_always` as a literal rather
# than reaching a Manifest for it, and `workflows.toml` gives the reason: new
# behaviour is the case where the engineer looks every time.
#
# **`implements_the_scope` tolerates an unscoped restructure, and its sibling is
# why it can.** Its *and nothing outside it* clause refused a Job whose Drone
# built the scoped feature and also split a module that had reached the 900-line
# hard refusal -- while `no_behaviour_beyond_scope` had already answered the
# question that mattered, and answered it `met`. #190 removed the clause.
#
# **The two must not converge.** Narrowing this one to behaviour makes it a
# second spelling of the criterion beside it, and the two disagreeing is what
# made that refusal legible at all: *the behaviour is exactly what you scoped;
# the diff contains work you did not scope*. Widening its sibling is the same
# mistake from the other end -- `no_behaviour_beyond_scope` is what caught a
# Drone doing three steps' work in one PR, which is `docs/scope.md`'s fourth
# pain.
#
# **`scope` carries two criteria rather than one.** A note can address the
# request and still be too vague to scope anything, and the two failures look
# nothing alike to whoever reads the refusal.
{
  "version": 1,
  "workflow_id": "feature",
  "name": "feature",
  "structure": "linear",
  "steps": [
    {
      "id": "scope",
      "label": "Scope the change",
      "evidence_type": "facts_note",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/scope.md"
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        # The ordinary tier: boundaries a Judge may lift when a Drone asks and
        # the request makes sense. Secrets, CI configuration and the workflow
        # definitions are not stated here -- nothing lifts those and no file a
        # Drone has a worktree of names them. `docs/contracts/configuration.md`.
        "exclude_paths": [
          "node_modules/",
          "target/"
        ]
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "addresses_the_request",
              "question": "Does this scope note address what was actually requested, without expanding beyond it?"
            },
            {
              "criterion_id": "names_what_it_will_touch",
              "question": "Does this scope note name the specific files, modules or behaviours the change will touch, rather than restating the request in other words?"
            }
          ]
        }
      ],
      "delivers": false,
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "implement",
      "label": "Implement",
      "evidence_type": "diff",
      "retry_limit": 2,
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "build",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "format",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "typecheck",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "bridge_build",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "storybook",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "bridge_test",
          "expect_exit_code": 0
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "declare_plan_at": "step_start",
      "evidence_scope": {
        "context_source": "drone_declared",
        # The ordinary tier: boundaries a Judge may lift when a Drone asks and
        # the request makes sense. Secrets, CI configuration and the workflow
        # definitions are not stated here -- nothing lifts those and no file a
        # Drone has a worktree of names them. `docs/contracts/configuration.md`.
        "exclude_paths": [
          "node_modules/",
          "target/"
        ],
        "reference_docs": [
          "scope.evidence"
        ],
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "implements_the_scope",
              "question": "Does this diff implement what the scope note described, rather than something else in its place? Unscoped work that only restructures -- a move, a rename, a file split that leaves behaviour where it was -- is not a refusal on this criterion."
            },
            {
              "criterion_id": "no_behaviour_beyond_scope",
              "question": "Does this diff change behaviour beyond what the scope note described?"
            }
          ]
        }
      ],
      "delivers": false,
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "tests",
      "label": "Write tests",
      "evidence_type": "diff",
      "retry_limit": 2,
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "test",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "format",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "typecheck",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "bridge_build",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "storybook",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "bridge_test",
          "expect_exit_code": 0
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        # The ordinary tier: boundaries a Judge may lift when a Drone asks and
        # the request makes sense. Secrets, CI configuration and the workflow
        # definitions are not stated here -- nothing lifts those and no file a
        # Drone has a worktree of names them. `docs/contracts/configuration.md`.
        "exclude_paths": [
          "node_modules/",
          "target/"
        ],
        "reference_docs": [
          "scope.evidence"
        ],
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "tests_exercise_behaviour",
              "question": "Do these tests exercise the behaviour the scope note described, rather than restating the implementation?"
            }
          ],
          "gaming_check": {
            "enabled": true,
            "baseline_ref": "scope.evidence",
            "flag_if": [
              "assertion_weakened",
              "test_scope_narrowed",
              "tautological_test",
              "check_config_edited"
            ]
          }
        }
      ],
      "delivers": false,
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "handoff",
      "label": "Summarise",
      "evidence_type": "facts_note",
      "model": "haiku",
      "delivers": true,
      "advance_gate": "human_always"
    }
  ]
}
