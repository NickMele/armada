# Feature, reduced to what M1's parser accepts.
# See `bug.json` beside this file for the shape all seven hold to, for why a
# reduced form exists at all, and for the three ways the designed samples under
# `crates/core-model/domain/workflow-samples/` are stale against the parser --
# `question` where it reads `criteria[]`, `declare_plan_at` inside
# `evidence_scope` where the registry parents it to the step, and
# `max_context_size`, which M1 does not read. `reference_docs` was a fourth and
# is not any more -- M1 reads it. The questions below are ported from the
# designed files; none of the shape is.
#
# The designed `feature.json` runs seven steps in a loop, with Judge checks on
# five and a human gate at review. This form keeps `scope`, `implement` and
# `tests`, and folds `review`, `merge` and `close` into one `handoff` -- the
# same fold `bug.json` makes.
#
# **`handoff` is gated `human_always`, and that is the folded `review` step's
# own gate.** Folding steps folds their gates too, and of the three the fold
# swallows, `review`'s is the strictest -- `merge` and `close` reach for a
# Manifest rule that is still refused. So the last thing before the work lands
# is a person reading it, which is what the designed `review` says and what
# Bug's cannot say, since Bug's review gate is `manifest_rule:review_gate`.
#
# Feature is where the designed file spells `human_always` as a literal rather
# than reaching a Manifest for it, and `workflows.toml` gives the reason: new
# behaviour is the case where the engineer looks every time.
#
# `regression_verify`'s question does not vanish with its step. It is carried
# as `implement`'s second criterion, which is the step whose diff it was asking
# about; the designed file only separates them because its loop can route back
# to one and not the other.
#
# `tests` carries the designed `regression_verify`'s `test` check itself rather
# than a separate step, and carries the gaming check the designed file puts
# there -- a test step is exactly where a weakened assertion pays off.
#
# **`handoff` still carries no Judge.** A step with no criterion asks the Judge
# nothing, and the designed `review` pairs its human gate with a summary check
# declaring `gates_advancement: false` -- a key M1's parser does not read.
# Porting it would turn a summary written for the reviewer into a veto standing
# between the reviewer and the work.
#
# **A step whose `evidence_type` is `facts_note` carries a Judge again.** The
# Judge is shown what the step produced, and on a written step that is the note
# -- `verification::Product` reads the step's own declared `evidence_type` to
# decide which. The rule that a Drone's account of *how the step went* stays out
# is untouched; what changed is that its deliverable is no longer folded into
# that account. See #153.
#
# `reference_docs` is read now too, so a later step names what an earlier step
# established and the Judge is shown it, labelled as the standard rather than
# the target.
#
# **The Judge is shown the request now**, which is what `judge.md` rule 2 said
# all along and what #169 built: the Job's title, its facts and its acceptance
# criteria are on every brief.
#
# **`scope` is the step that must not go unverified**, because a Drone that
# scopes wrongly does the wrong work for every step after it. Its designed
# criterion is restored below in the designed wording, and it is the half that
# needed the request: a beautifully specific note about the wrong change passes
# every question that reads the note alone. The narrower criterion stays beside
# it rather than being replaced -- a note can address the request and still be
# too vague to scope anything, and the two failures look nothing alike to
# whoever reads the refusal.
#
# **What is still not joined.** `acceptance_criteria[]` belongs to the Job and
# no criterion here names which of them it tests; `config/src/judge.rs` refuses
# `source_ref` for that reason. The brief labels them as the whole Job's bar
# rather than the step's, so a scope note is not refused for not having shipped
# the feature -- but a criterion that wanted to test one of them by name still
# cannot be written.
#
# Each criterion is its own call, so the entry below is one more Judge call per
# Job on Feature's cheapest step.
{
  "version": 1,
  "workflow_id": "feature",
  "name": "feature",
  "structure": "linear",
  "steps": [
    {
      "id": "scope",
      "label": "Scope the change",
      "evidence_type": "facts_note",
      "evidence_scope": {
        "context_source": "drone_declared",
        "exclude_paths": [
          ".env",
          "node_modules/",
          "target/"
        ]
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "addresses_the_request",
              "question": "Does this scope note address what was actually requested, without expanding beyond it?"
            },
            {
              "criterion_id": "names_what_it_will_touch",
              "question": "Does this scope note name the specific files, modules or behaviours the change will touch, rather than restating the request in other words?"
            }
          ]
        }
      ],
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "implement",
      "label": "Implement",
      "evidence_type": "diff",
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "build",
          "expect_exit_code": 0
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "declare_plan_at": "step_start",
      "evidence_scope": {
        "context_source": "drone_declared",
        "exclude_paths": [
          ".env",
          "node_modules/",
          "target/"
        ],
        "reference_docs": [
          "scope.evidence"
        ],
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "implements_the_scope",
              "question": "Does this diff implement what the scope note described, and nothing outside it?"
            },
            {
              "criterion_id": "no_behaviour_beyond_scope",
              "question": "Does this diff change behaviour beyond what the scope note described?"
            }
          ]
        }
      ],
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "tests",
      "label": "Write tests",
      "evidence_type": "diff",
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "test",
          "expect_exit_code": 0
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared",
        "exclude_paths": [
          ".env",
          "node_modules/",
          "target/"
        ],
        "reference_docs": [
          "scope.evidence"
        ],
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "tests_exercise_behaviour",
              "question": "Do these tests exercise the behaviour the scope note described, rather than restating the implementation?"
            }
          ],
          "gaming_check": {
            "enabled": true,
            "baseline_ref": "scope.evidence",
            "flag_if": [
              "assertion_weakened",
              "test_scope_narrowed",
              "tautological_test",
              "check_config_edited"
            ]
          }
        }
      ],
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "handoff",
      "label": "Summarise",
      "evidence_type": "facts_note",
      "advance_gate": "human_always"
    }
  ]
}
