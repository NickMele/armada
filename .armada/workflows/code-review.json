# Code Review, reduced to what M1's parser accepts. `bug.json` beside this file
# carries what all eight hold to, and where the schema, the catalogue and the
# Check reasoning live.
#
# The designed `code-review.json` is already linear and already three steps, so
# nothing here is folded. What is dropped is `deliver`'s
# `manifest_rule:review_gate`, which the parser defers. `assess`'s
# `evidence_type` is `facts_note` rather than the designed `review_findings`,
# which is not a value the schema has -- `[review-findings-evidence-type]` in
# `docs/OPEN.md`.
#
# **`assess` carries no Judge, and what holds it is the diff.** On Code Review
# the diff is the Drone's *input* rather than its output, so it is not in the
# worktree and `WorkProduct::patch` reads nothing. Every criterion this step
# would declare -- does the review engage with what the diff does, are the
# findings tied to changed lines, would they read the same about a different
# diff -- is a question about that diff, and `no_findings_on_substantial_diff`
# and its two siblings go through `GamingBrief`, which takes a patch and nothing
# else. This is the "Code Review inverts" exception `docs/concepts/workflow.md`
# flags against its own evidence-type table, and it needs a step whose work
# product is a review of a diff Armada holds somewhere it can read.
#
# **So `artifact_exists` on `read` and on `assess` is more load-bearing here
# than anywhere else.** With no Judge over `assess`, a `read` step that produced
# nothing would otherwise reach `assess` and `deliver` unnoticed. The designed
# targets are a registry name and `REVIEW.md`; M1 has no artifact registry, so
# both are paths.
{
  "version": 1,
  "workflow_id": "code_review",
  "name": "code_review",
  "structure": "linear",
  "steps": [
    {
      "id": "read",
      "label": "Read the diff",
      "evidence_type": "facts_note",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/read.md"
        }
      ],
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "assess",
      "label": "Assess",
      "evidence_type": "facts_note",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/assess.md"
        }
      ],
      "evidence_scope": {
        "context_source": "hybrid",
        # The ordinary tier: boundaries a Judge may lift when a Drone asks and
        # the request makes sense. Secrets, CI configuration and the workflow
        # definitions are not stated here -- nothing lifts those and no file a
        # Drone has a worktree of names them. `docs/contracts/configuration.md`.
        "exclude_paths": [
          "node_modules/",
          "target/"
        ]
      },
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "deliver",
      "label": "Deliver the review",
      "evidence_type": "bundle",
      "model": "haiku",
      "delivers": false,
      "advance_gate": "auto"
    }
  ]
}
