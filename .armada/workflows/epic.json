# Epic -- a milestone dispatched as one Job. Its product is not a diff, it is
# other Jobs. #215; `docs/capabilities/epic-as-one-job.md` is the reasoning at
# length, `crates/core-model/domain/workflows.toml` the catalogue row, and
# `bug.json` beside this file what every definition here holds to.
#
# **This is the only definition that ships with `may_dispatch_jobs`**, on
# `dispatch` alone. `crates/config/tests/shipped.rs` asserts that pair and says
# why that step alone may have it.
#
# **`human_always` is on `plan` and not on `dispatch`, and the placement is
# forced.** A gate is read after its step's Drone submits, so the same key on
# the dispatching step would be a person approving a spend that had already
# happened. On the step before it, the approval is what advances into the step
# holding the tool -- so approving the plan is what dispatches the wave.
#
# **`dispatch` carries no Judge, and that is a decision.** A refusal there
# arrives after the Jobs exist and cannot un-create them; all it could do is
# stop the step that reports on them. The place to refuse a bad split is `plan`,
# which is where both criteria are: one asks whether the split is drawn, the
# other whether each piece carries what `dispatch_job` will be asked for -- a
# brief and a bar.
#
# **`dispatch` writes a file too**, though its real product is Jobs no
# mechanical check can read. What the file gives is the parent's own record of
# the wave it created, at a path a person and the next Drone can open. A step
# whose only gate was "it submitted something" would be the weakest gate in the
# repository on the most consequential act in it.
#
# **What the Drone is told about any of this is `fleet::terms`', not this
# file's.** A step definition has no field for prose. `Splitting` in
# `crates/fleet/src/terms.rs` is the block, and it is keyed off
# `may_dispatch_jobs` on this step or the next one rather than off this
# workflow's name.
{
  "version": 1,
  "workflow_id": "epic",
  "name": "epic",
  "structure": "loop",
  "steps": [
    {
      "id": "plan",
      "label": "Plan the wave",
      "evidence_type": "document",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/plan.md"
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "draws_the_split",
              "question": "Does this plan draw the split -- a node for each Job it proposes, and an edge wherever one of them has to wait for another -- rather than describing the split in prose alone?"
            },
            {
              "criterion_id": "each_piece_carries_its_own_brief",
              "question": "Does the plan say, for every Job it proposes, what that Job's agent is to be told and what its work will be held to, rather than naming the piece and leaving both to be worked out later?"
            }
          ]
        }
      ],
      "delivers": false,
      "advance_gate": "human_always"
    },
    {
      "id": "dispatch",
      "label": "Dispatch the wave",
      "evidence_type": "facts_note",
      "may_dispatch_jobs": true,
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/dispatched.md"
        }
      ],
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "roll_up",
      "label": "Roll up the wave",
      "evidence_type": "document",
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/roll-up.md"
        }
      ],
      "delivers": false,
      "advance_gate": "human_always",
      "verdict_routing": {
        "request_changes": "plan"
      },
      "iteration_cap": 5
    }
  ]
}
