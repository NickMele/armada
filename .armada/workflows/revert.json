# Revert, reduced to what M1's parser accepts. `bug.json` beside this file
# carries what all eight hold to, and where the schema, the catalogue and the
# Check reasoning live.
#
# The designed `revert.json` runs five steps in a loop and opens on `revert`
# itself -- there is no plan step, since a revert's scope is inherited from the
# Job it undoes rather than classified. This form keeps that shape: `revert`,
# then `review` + `merge` + `close` folded into one `handoff`.
#
# **`handoff` is gated `human_always`**, which is the folded `review` step's own
# gate -- see `feature.json` for why a fold takes the strictest of the three.
# Revert is the second workflow whose designed `review` spells `human_always` as
# a literal, and `workflows.toml` gives the opposite reason to Feature's:
# Feature's review is human because the behaviour is new, this one because the
# behaviour is old, worked, and is being thrown away.
#
# **The designed `revert` step carries a judge check with no question in it.**
# That is a hole in the sample rather than a decision, so the criteria below are
# written here rather than ported. What a revert has to be judged on is narrow
# and obvious: that it undoes the named change, and that it undoes only that.
#
# `revert` carries the designed `regression_verify`'s `test` check, dropping its
# `lint` check, which this repository's Manifest does not declare.
{
  "version": 1,
  "workflow_id": "revert",
  "name": "revert",
  "structure": "linear",
  "steps": [
    {
      "id": "revert",
      "label": "Undo the change",
      "evidence_type": "diff",
      "retry_limit": 2,
      "mechanical_checks": [
        {
          "type": "every_manifest_check"
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "declare_plan_at": "step_start",
      "evidence_scope": {
        "context_source": "drone_declared",
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "undoes_the_named_change",
              "question": "Does this diff undo the change it was dispatched to undo?"
            },
            {
              "criterion_id": "undoes_nothing_else",
              "question": "Does this diff undo or alter anything beyond the change it names?"
            }
          ]
        }
      ],
      "delivers": false,
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "handoff",
      "label": "Summarise",
      "evidence_type": "facts_note",
      "model": "haiku",
      "delivers": true,
      "advance_gate": "human_always"
    }
  ]
}
