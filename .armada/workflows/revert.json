# Revert, reduced to what M1's parser accepts.
# See `bug.json` beside this file for the shape all seven hold to, for why a
# reduced form exists at all, and for the three ways the designed samples under
# `crates/core-model/domain/workflow-samples/` are stale against the parser --
# `question` where it reads `criteria[]`, `declare_plan_at` inside
# `evidence_scope` where the registry parents it to the step, and
# `max_context_size`, which M1 does not read. `reference_docs` was a fourth and
# is not any more -- M1 reads it. The questions below are ported from the
# designed files; none of the shape is.
#
# The designed `revert.json` runs five steps in a loop and opens on `revert`
# itself -- there is no plan step, since a revert's scope is inherited from the
# Job it undoes rather than classified. This form keeps that shape: `revert`,
# then `review` + `merge` + `close` folded into one `handoff`.
#
# **`handoff` is gated `human_always`**, which is the folded `review` step's
# own gate -- see `feature.json` for why a fold takes the strictest of the
# three. Revert is the second workflow whose designed `review` spells
# `human_always` as a literal, and `workflows.toml` gives the opposite reason
# to Feature's: Feature's review is human because the behaviour is new, this
# one because the behaviour is old, worked, and is being thrown away.
#
# **The designed `revert` step carries a judge check with no question in it.**
# That is a hole in the sample, not a decision, so the criteria below are
# written here rather than ported. What a revert has to be judged on is narrow
# and obvious: that it undoes the named change, and that it undoes only that.
#
# `revert` carries the designed `regression_verify`'s `test` check itself,
# dropping its `lint` check, which this repository's Manifest does not declare.
#
# `handoff` carries no Judge. A step with no criterion asks the Judge nothing,
# and the designed `review`'s summary check declares `gates_advancement:
# false`, which M1's parser does not read -- see `feature.json`.
{
  "version": 1,
  "workflow_id": "revert",
  "name": "revert",
  "structure": "linear",
  "steps": [
    {
      "id": "revert",
      "label": "Undo the change",
      "evidence_type": "diff",
      "retry_limit": 2,
      "mechanical_checks": [
        {
          "type": "manifest_check",
          "check": "build",
          "expect_exit_code": 0
        },
        {
          "type": "manifest_check",
          "check": "test",
          "expect_exit_code": 0
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "declare_plan_at": "step_start",
      "evidence_scope": {
        "context_source": "drone_declared",
        "exclude_paths": [
          ".env",
          "node_modules/",
          "target/"
        ],
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "undoes_the_named_change",
              "question": "Does this diff undo the change it was dispatched to undo?"
            },
            {
              "criterion_id": "undoes_nothing_else",
              "question": "Does this diff undo or alter anything beyond the change it names?"
            }
          ]
        }
      ],
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "handoff",
      "label": "Summarise",
      "evidence_type": "facts_note",
      "advance_gate": "human_always"
    }
  ]
}
